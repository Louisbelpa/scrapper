# ── Notifications push (ntfy.sh) ──────────────────────────────────────────────
# Installez l'app ntfy sur iOS/Android et abonnez-vous à ce topic.
NTFY_TOPIC=mon-portasplit-alerte

# ── Notifications email (SMTP) ─────────────────────────────────────────────────
# Gmail : créez un "App Password" dans https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre.adresse@gmail.com
SMTP_PASS=votre-app-password-16-caracteres
EMAIL_FROM=PortaSplit Monitor <votre.adresse@gmail.com>

# ── Autres providers SMTP ──────────────────────────────────────────────────────
# Resend (100 emails/jour gratuits) :
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USER=resend
#   SMTP_PASS=re_xxxx
#
# Brevo (300 emails/jour gratuits) :
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=votre@email.com
#   SMTP_PASS=votre-cle-brevo
